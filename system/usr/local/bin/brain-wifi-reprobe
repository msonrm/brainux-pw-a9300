#!/bin/sh
# After waking: if a Wi-Fi stick that rtl8xxxu66 handles is on the bus with no
# driver (the probe that resume redoes failed, -11 while writing the firmware),
# cut the power of its hub's ports and give it back, the same as replugging
# the stick. Deauthorizing and authorizing it is not enough: the driver binds
# again, but the stick receives nothing until it loses power. The hub here
# switches its ports' power together (ganged), so the power goes off only when
# every port is disabled, and anything else on the hub goes off with it.
# Started by /usr/lib/systemd/system-sleep/brain-wifi-reprobe; watches for
# 60 s, at most 2 tries. Messages go to the journal.
DRV=rtl8xxxu66

unbound() {
	for i in /sys/bus/usb/devices/*:1.0; do
		[ -e "$i/driver" ] && continue
		[ -r "$i/modalias" ] || continue
		/usr/sbin/modprobe -q --resolve-alias "$(cat "$i/modalias")" 2>/dev/null |
			grep -qx "$DRV" || continue
		echo "${i%:1.0}"
	done
}

# $1: the stick, e.g. /sys/bus/usb/devices/1-1.3
powercycle() {
	name=${1##*/}
	hub=${name%.*}
	ports=$(ls -d /sys/bus/usb/devices/$hub/$hub:1.0/$hub-port* 2>/dev/null)
	if [ "$hub" = "$name" ] || [ -z "$ports" ]; then
		echo "$name is not behind a hub, deauthorizing it instead"
		echo 0 > "$1/authorized"
		sleep 1
		echo 1 > "$1/authorized"
		return
	fi
	others=$(ls -d /sys/bus/usb/devices/$hub.* 2>/dev/null | grep -v "/$name\$" | grep -v :)
	[ -n "$others" ] && echo "also cutting the power of$(for o in $others; do printf ' %s' "${o##*/}"; done)"
	# Keep the hub and the hubs above it out of runtime suspend until the
	# stick is back: with no child the hub suspends at once, and right after
	# waking it then missed the stick connecting again (2026-10-15).
	awake=
	d=/sys/bus/usb/devices/$hub
	while [ -e "$d/devnum" ]; do   # USB devices only, up to the root hub
		awake="$awake $d=$(cat "$d/power/control")"
		echo on > "$d/power/control"
		d=$(readlink -f "$d/..")
	done
	off=
	for p in $ports; do
		[ "$(cat "$p/disable")" = 0 ] || continue
		echo 1 > "$p/disable" && off="$off $p"
	done
	sleep 2
	for p in $off; do
		echo 0 > "$p/disable"
	done
	for w in $(seq 10); do
		sleep 1
		[ -e "$1" ] && break
	done
	[ -e "$1" ] && echo "$name is back ${w}s after its power returned" ||
		echo "$name did not come back within 10 s"
	for a in $awake; do
		echo "${a##*=}" > "${a%=*}/power/control"
	done
}

seen=0 tries=0
for t in $(seq 60); do
	sleep 1
	devs=$(unbound)
	if [ -z "$devs" ]; then
		seen=0
		continue
	fi
	seen=$((seen + 1))
	[ $seen -lt 3 ] && continue   # give a probe in progress time to finish
	[ $tries -ge 2 ] && { echo "still no driver after $tries tries: $devs"; exit 1; }
	tries=$((tries + 1)) seen=0
	for d in $devs; do
		echo "no driver on ${d##*/} ${t}s after waking, cutting its power (try $tries)"
		powercycle "$d"
	done
done
exit 0
