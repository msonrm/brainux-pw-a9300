[Unit]
Description=Sub panel as a touchpad and a status strip
After=systemd-modules-load.service

[Service]
ExecStart=/usr/local/bin/subpaneld
Restart=on-failure
RestartSec=5
# ahead of what runs while logind gets ready to suspend, so the ring on the
# sub panel keeps moving (and the pointer too)
Nice=-10

[Install]
WantedBy=multi-user.target
