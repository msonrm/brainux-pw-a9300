From: brainux-pw-a9300
Subject: [PATCH] pwm: mxs: drive the inactive level before stopping a channel

A stopped i.MX28 PWM channel keeps driving whatever level it was at.
On Brain PW-A9300 the backlight (pwm 0, full duty at brightness 7) stayed
lit with brightness 0 and through suspend. Set ACTIVE/INACTIVE to the off
level, wait two periods for it to latch, then stop the channel.

Checked on PW-A9300: brightness 0 and s2idle now turn the backlight off.

diff --git a/drivers/pwm/pwm-mxs.c b/drivers/pwm/pwm-mxs.c
index 766dbc58d..ba4186e6a 100644
--- a/drivers/pwm/pwm-mxs.c
+++ b/drivers/pwm/pwm-mxs.c
@@ -4,6 +4,7 @@
  */
 
 #include <linux/clk.h>
+#include <linux/delay.h>
 #include <linux/err.h>
 #include <linux/io.h>
 #include <linux/kernel.h>
@@ -65,8 +66,25 @@ static int mxs_pwm_apply(struct pwm_chip *chip, struct pwm_device *pwm,
 			return ret;
 	}
 
-	if (!state->enabled && pwm_is_enabled(pwm))
+	if (!state->enabled && pwm_is_enabled(pwm)) {
+		/*
+		 * A stopped channel keeps driving its last output level, so a
+		 * backlight left at full duty stays lit. Force the output to
+		 * the inactive level for a whole period before stopping.
+		 */
+		void __iomem *active = mxs->base + PWM_ACTIVE0 + pwm->hwpwm * 0x20;
+		void __iomem *period = mxs->base + PWM_PERIOD0 + pwm->hwpwm * 0x20;
+		u32 off = pwm->state.polarity == PWM_POLARITY_NORMAL ?
+			PERIOD_ACTIVE_LOW | PERIOD_INACTIVE_LOW :
+			PERIOD_ACTIVE_HIGH | PERIOD_INACTIVE_HIGH;
+
+		writel(readl(active), active);
+		writel((readl(period) & ~(0xf << 16)) | off, period);
+		/* New settings take effect at the start of the next period */
+		usleep_range(2 * DIV_ROUND_UP_ULL(pwm->state.period, 1000) + 1,
+			     2 * DIV_ROUND_UP_ULL(pwm->state.period, 1000) + 20);
 		writel(1 << pwm->hwpwm, mxs->base + PWM_CTRL + CLR);
+	}
 
 	rate = clk_get_rate(mxs->clk);
 	while (1) {
