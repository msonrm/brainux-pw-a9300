diff --git a/sound/soc/mxs/mxs-ymu818.c b/sound/soc/mxs/mxs-ymu818.c
new file mode 100644
index 000000000..7b1788fa8
--- /dev/null
+++ b/sound/soc/mxs/mxs-ymu818.c
@@ -0,0 +1,130 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * ASoC machine driver for MXS boards with a Yamaha YMU818 on SAIF0
+ * (SHARP Brain PW-A9300). Based on mxs-sgtl5000.c:
+ *
+ * Copyright 2011 Freescale Semiconductor, Inc.
+ */
+
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <sound/pcm.h>
+#include <sound/soc.h>
+
+#include "mxs-saif.h"
+
+/* The YMU818 PLL runs from MCLK = 512fs; the WinCE driver uses 44.1kHz only */
+#define MXS_YMU818_RATE		44100
+#define MXS_YMU818_MCLK_FS	512
+
+static int mxs_ymu818_hw_params(struct snd_pcm_substream *substream,
+				struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = asoc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = asoc_rtd_to_cpu(rtd, 0);
+	unsigned int mclk = MXS_YMU818_MCLK_FS * params_rate(params);
+	int ret;
+
+	ret = snd_soc_dai_set_sysclk(cpu_dai, MXS_SAIF_MCLK, mclk, 0);
+	if (ret)
+		dev_err(cpu_dai->dev, "failed to set mclk to %u Hz\n", mclk);
+	return ret;
+}
+
+static const struct snd_soc_ops mxs_ymu818_ops = {
+	.hw_params = mxs_ymu818_hw_params,
+};
+
+SND_SOC_DAILINK_DEFS(hifi_tx,
+	DAILINK_COMP_ARRAY(COMP_EMPTY()),
+	DAILINK_COMP_ARRAY(COMP_CODEC(NULL, "ymu818-hifi")),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+static struct snd_soc_dai_link mxs_ymu818_dai = {
+	.name		= "HiFi Tx",
+	.stream_name	= "HiFi Playback",
+	.dai_fmt	= SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF |
+			  SND_SOC_DAIFMT_CBC_CFC,
+	.ops		= &mxs_ymu818_ops,
+	.playback_only	= true,
+	SND_SOC_DAILINK_REG(hifi_tx),
+};
+
+static struct snd_soc_card mxs_ymu818 = {
+	.name		= "mxs_ymu818",
+	.owner		= THIS_MODULE,
+	.dai_link	= &mxs_ymu818_dai,
+	.num_links	= 1,
+};
+
+static int mxs_ymu818_probe(struct platform_device *pdev)
+{
+	struct snd_soc_card *card = &mxs_ymu818;
+	struct device_node *np = pdev->dev.of_node;
+	struct device_node *saif_np, *codec_np;
+	int ret;
+
+	saif_np = of_parse_phandle(np, "saif-controllers", 0);
+	codec_np = of_parse_phandle(np, "audio-codec", 0);
+	if (!saif_np || !codec_np) {
+		dev_err(&pdev->dev, "phandle missing or invalid\n");
+		of_node_put(codec_np);
+		of_node_put(saif_np);
+		return -EINVAL;
+	}
+
+	mxs_ymu818_dai.codecs->name = NULL;
+	mxs_ymu818_dai.codecs->of_node = codec_np;
+	mxs_ymu818_dai.cpus->dai_name = NULL;
+	mxs_ymu818_dai.cpus->of_node = saif_np;
+	mxs_ymu818_dai.platforms->name = NULL;
+	mxs_ymu818_dai.platforms->of_node = saif_np;
+	of_node_put(codec_np);
+	of_node_put(saif_np);
+
+	/*
+	 * Keep MCLK running from SAIF0: the YMU818 needs it for its PLL while
+	 * the init and start sequences run, as in the WinCE driver.
+	 */
+	ret = mxs_saif_get_mclk(0, MXS_YMU818_MCLK_FS * MXS_YMU818_RATE,
+				MXS_YMU818_RATE);
+	if (ret) {
+		dev_err(&pdev->dev, "failed to get mclk\n");
+		return ret;
+	}
+
+	card->dev = &pdev->dev;
+	ret = devm_snd_soc_register_card(&pdev->dev, card);
+	if (ret) {
+		mxs_saif_put_mclk(0);
+		return dev_err_probe(&pdev->dev, ret, "snd_soc_register_card failed\n");
+	}
+	return 0;
+}
+
+static int mxs_ymu818_remove(struct platform_device *pdev)
+{
+	mxs_saif_put_mclk(0);
+	return 0;
+}
+
+static const struct of_device_id mxs_ymu818_dt_ids[] = {
+	{ .compatible = "fsl,mxs-audio-ymu818", },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, mxs_ymu818_dt_ids);
+
+static struct platform_driver mxs_ymu818_audio_driver = {
+	.driver = {
+		.name = "mxs-ymu818",
+		.of_match_table = mxs_ymu818_dt_ids,
+	},
+	.probe = mxs_ymu818_probe,
+	.remove = mxs_ymu818_remove,
+};
+module_platform_driver(mxs_ymu818_audio_driver);
+
+MODULE_DESCRIPTION("MXS ALSA SoC machine driver for YMU818");
+MODULE_LICENSE("GPL");
+MODULE_ALIAS("platform:mxs-ymu818");
