diff --git a/sound/soc/codecs/ymu818.c b/sound/soc/codecs/ymu818.c
new file mode 100644
index 000000000..c3d4fa41a
--- /dev/null
+++ b/sound/soc/codecs/ymu818.c
@@ -0,0 +1,665 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Yamaha YMU818 codec driver
+ *
+ * Used in SHARP Brain PW-A9300. The register programming sequences are not in
+ * this driver: they come from a firmware file that each user extracts from the
+ * WinCE driver of their own device. The firmware is loaded on the first
+ * playback, when the root filesystem is available.
+ *
+ * The output goes to the mono speaker or, when something is plugged into the
+ * headphone jack, to the headphones. The path follows the jack during
+ * playback, as in the WinCE driver.
+ *
+ * Firmware format (little endian):
+ *   "YMU818SQ" u16 version(=1) u16 nsect
+ *   section: u8 id, u8 reserved, u16 nops, ops...
+ *   op: 1 WRITE    u16 reg, u16 len, u8 data[len]  (one I2C transaction)
+ *       2 READ     u16 reg
+ *       3 WAIT_SET u16 reg, u8 mask
+ *       4 WAIT_CLR u16 reg, u8 mask
+ *       5 DELAY    u16 ms
+ */
+
+#include <linux/delay.h>
+#include <linux/firmware.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/slab.h>
+#include <linux/workqueue.h>
+#include <sound/jack.h>
+#include <sound/pcm.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include <asm/unaligned.h>
+
+#define YMU818_FW_MAGIC		"YMU818SQ"
+#define YMU818_FW_VERSION	1
+#define YMU818_FW_DEFAULT	"ymu818-brain.bin"
+
+enum ymu818_section_id {
+	YMU818_SEC_INIT = 1,
+	YMU818_SEC_START_SPK,
+	YMU818_SEC_STOP_SPK,
+	YMU818_SEC_AMP_ON_SPK,
+	YMU818_SEC_AMP_OFF_SPK,
+	YMU818_SEC_START_HP,
+	YMU818_SEC_STOP_HP,
+	YMU818_SEC_AMP_ON_HP,
+	YMU818_SEC_AMP_OFF_HP,
+	YMU818_SEC_MAX,
+};
+
+enum ymu818_op {
+	YMU818_OP_WRITE = 1,
+	YMU818_OP_READ,
+	YMU818_OP_WAIT_SET,
+	YMU818_OP_WAIT_CLR,
+	YMU818_OP_DELAY,
+};
+
+/* Speaker volume: 0x20 | step, step 0..27. 0x20 alone is silent. */
+#define YMU818_REG_SPK_VOL	0x025
+#define YMU818_SPK_VOL_BASE	0x20
+#define YMU818_SPK_VOL_MAX	27
+#define YMU818_SPK_VOL_DEFAULT	12
+
+/*
+ * Headphone volume: 0x023 = 0x60 | step, 0x024 = step, step 0..31. The WinCE
+ * driver writes the same step to both (probably left and right).
+ */
+#define YMU818_REG_HP_VOL	0x023
+#define YMU818_HP_VOL_BASE	0x60
+#define YMU818_HP_VOL_MAX	31
+#define YMU818_HP_VOL_DEFAULT	8
+
+#define YMU818_HP_DEBOUNCE_MS	200
+
+#define YMU818_WAIT_TRIES	200
+
+struct ymu818_section {
+	const u8 *ops;
+	size_t len;
+	unsigned int nops;
+};
+
+struct ymu818_priv {
+	struct i2c_client *i2c;
+	struct gpio_desc *reset;
+	struct gpio_desc *hp_det;
+	struct snd_soc_jack jack;
+	struct delayed_work hp_work;
+	int hp_irq;
+	bool hp_irq_off;	/* the irq disabled itself until hp_work runs */
+	const char *fw_name;
+	const struct firmware *fw;
+	struct ymu818_section sec[YMU818_SEC_MAX];
+	struct mutex lock;	/* protects the chip state below */
+	bool inited;
+	bool running;
+	bool hp;		/* the path in use while running */
+	unsigned int spk_vol;
+	unsigned int hp_vol;
+};
+
+/*
+ * Register addresses are sent 7 bits at a time, low bits first. The byte
+ * with bit 7 set ends the address, so 0x00..0x7f take one byte.
+ */
+static int ymu818_addr(unsigned int reg, u8 *buf)
+{
+	if (reg < 0x80) {
+		buf[0] = 0x80 | reg;
+		return 1;
+	}
+	buf[0] = reg & 0x7f;
+	buf[1] = 0x80 | (reg >> 7);
+	return 2;
+}
+
+static int ymu818_write(struct ymu818_priv *ymu, unsigned int reg,
+			const u8 *data, size_t len)
+{
+	u8 *buf;
+	int n, ret;
+
+	buf = kmalloc(len + 2, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	n = ymu818_addr(reg, buf);
+	memcpy(buf + n, data, len);
+	ret = i2c_master_send(ymu->i2c, buf, n + len);
+	kfree(buf);
+	if (ret < 0)
+		return ret;
+	return ret == n + len ? 0 : -EIO;
+}
+
+static int ymu818_read(struct ymu818_priv *ymu, unsigned int reg, u8 *val)
+{
+	u8 addr[2];
+	struct i2c_msg msgs[2] = {
+		{ .addr = ymu->i2c->addr, .flags = 0, .buf = addr },
+		{ .addr = ymu->i2c->addr, .flags = I2C_M_RD, .len = 1, .buf = val },
+	};
+	int ret;
+
+	msgs[0].len = ymu818_addr(reg, addr);
+	ret = i2c_transfer(ymu->i2c->adapter, msgs, 2);
+	if (ret < 0)
+		return ret;
+	return ret == 2 ? 0 : -EIO;
+}
+
+static int ymu818_wait(struct ymu818_priv *ymu, unsigned int reg, u8 mask,
+		       bool set)
+{
+	int i, ret;
+	u8 val = 0;
+
+	for (i = 0; i < YMU818_WAIT_TRIES; i++) {
+		ret = ymu818_read(ymu, reg, &val);
+		if (ret)
+			return ret;
+		if (set ? (val & mask) == mask : !(val & mask))
+			return 0;
+		usleep_range(1000, 1500);
+	}
+	dev_err(&ymu->i2c->dev, "timeout waiting for reg %03x bits %02x %s (now %02x)\n",
+		reg, mask, set ? "set" : "clear", val);
+	return -ETIMEDOUT;
+}
+
+static int ymu818_run(struct ymu818_priv *ymu, enum ymu818_section_id id)
+{
+	const struct ymu818_section *sec = &ymu->sec[id];
+	const u8 *p = sec->ops;
+	unsigned int i, reg, len;
+	int ret = 0;
+	u8 val;
+
+	for (i = 0; i < sec->nops && !ret; i++) {
+		reg = get_unaligned_le16(p + 1);
+		switch (p[0]) {
+		case YMU818_OP_WRITE:
+			len = get_unaligned_le16(p + 3);
+			ret = ymu818_write(ymu, reg, p + 5, len);
+			p += 5 + len;
+			break;
+		case YMU818_OP_READ:
+			ret = ymu818_read(ymu, reg, &val);
+			p += 3;
+			break;
+		case YMU818_OP_WAIT_SET:
+		case YMU818_OP_WAIT_CLR:
+			ret = ymu818_wait(ymu, reg, p[3], p[0] == YMU818_OP_WAIT_SET);
+			p += 4;
+			break;
+		case YMU818_OP_DELAY:
+			if (reg < 20)
+				usleep_range(reg * 1000, reg * 1000 + 500);
+			else
+				msleep(reg);
+			p += 3;
+			break;
+		}
+	}
+	if (ret)
+		dev_err(&ymu->i2c->dev, "section %d failed at op %u: %d\n", id, i, ret);
+	return ret;
+}
+
+/* Check every op against the firmware size so ymu818_run() can trust it. */
+static int ymu818_parse_fw(struct ymu818_priv *ymu)
+{
+	const u8 *p = ymu->fw->data, *end = p + ymu->fw->size;
+	unsigned int nsect, i, j, id, nops;
+	const u8 *start;
+
+	if (ymu->fw->size < 12 || memcmp(p, YMU818_FW_MAGIC, 8) ||
+	    get_unaligned_le16(p + 8) != YMU818_FW_VERSION)
+		goto bad;
+	nsect = get_unaligned_le16(p + 10);
+	p += 12;
+
+	for (i = 0; i < nsect; i++) {
+		if (end - p < 4)
+			goto bad;
+		id = p[0];
+		nops = get_unaligned_le16(p + 2);
+		p += 4;
+		start = p;
+		for (j = 0; j < nops; j++) {
+			size_t n;
+
+			if (end - p < 3)
+				goto bad;
+			switch (p[0]) {
+			case YMU818_OP_WRITE:
+				if (end - p < 5)
+					goto bad;
+				n = 5 + get_unaligned_le16(p + 3);
+				break;
+			case YMU818_OP_READ:
+			case YMU818_OP_DELAY:
+				n = 3;
+				break;
+			case YMU818_OP_WAIT_SET:
+			case YMU818_OP_WAIT_CLR:
+				n = 4;
+				break;
+			default:
+				goto bad;
+			}
+			if (end - p < n)
+				goto bad;
+			p += n;
+		}
+		if (id > 0 && id < YMU818_SEC_MAX) {
+			ymu->sec[id].ops = start;
+			ymu->sec[id].len = p - start;
+			ymu->sec[id].nops = nops;
+		}
+	}
+
+	for (i = YMU818_SEC_INIT; i < YMU818_SEC_MAX; i++) {
+		if (!ymu->sec[i].nops) {
+			dev_err(&ymu->i2c->dev, "%s: section %u missing\n", ymu->fw_name, i);
+			return -EINVAL;
+		}
+	}
+	return 0;
+bad:
+	dev_err(&ymu->i2c->dev, "%s: malformed firmware\n", ymu->fw_name);
+	return -EINVAL;
+}
+
+/* Load the firmware and run the init sequence. MCLK must be running. */
+static int ymu818_power_on(struct ymu818_priv *ymu)
+{
+	int ret;
+
+	if (ymu->inited)
+		return 0;
+
+	if (!ymu->fw) {
+		ret = request_firmware(&ymu->fw, ymu->fw_name, &ymu->i2c->dev);
+		if (ret)
+			return ret;
+		ret = ymu818_parse_fw(ymu);
+		if (ret) {
+			release_firmware(ymu->fw);
+			ymu->fw = NULL;
+			return ret;
+		}
+	}
+
+	/* Same reset pulse as the WinCE driver: high, low for 20ms, high */
+	if (ymu->reset) {
+		gpiod_set_value_cansleep(ymu->reset, 0);
+		usleep_range(10000, 11000);
+		gpiod_set_value_cansleep(ymu->reset, 1);
+		msleep(20);
+		gpiod_set_value_cansleep(ymu->reset, 0);
+	}
+
+	ret = ymu818_run(ymu, YMU818_SEC_INIT);
+	if (ret)
+		return ret;
+	ymu->inited = true;
+	return 0;
+}
+
+static int ymu818_set_spk_vol(struct ymu818_priv *ymu)
+{
+	u8 v = YMU818_SPK_VOL_BASE | ymu->spk_vol;
+
+	return ymu818_write(ymu, YMU818_REG_SPK_VOL, &v, 1);
+}
+
+static int ymu818_set_hp_vol(struct ymu818_priv *ymu)
+{
+	u8 v[2] = { YMU818_HP_VOL_BASE | ymu->hp_vol, ymu->hp_vol };
+
+	return ymu818_write(ymu, YMU818_REG_HP_VOL, v, 2);
+}
+
+static bool ymu818_hp_plugged(struct ymu818_priv *ymu)
+{
+	return ymu->hp_det && gpiod_get_value_cansleep(ymu->hp_det) > 0;
+}
+
+/* Turn on the path in ymu->hp. The amp_on sequences end at a fixed volume. */
+static int ymu818_path_on(struct ymu818_priv *ymu)
+{
+	int ret;
+
+	ret = ymu818_run(ymu, ymu->hp ? YMU818_SEC_START_HP : YMU818_SEC_START_SPK);
+	if (ret)
+		return ret;
+	ret = ymu818_run(ymu, ymu->hp ? YMU818_SEC_AMP_ON_HP : YMU818_SEC_AMP_ON_SPK);
+	if (ret)
+		return ret;
+	return ymu->hp ? ymu818_set_hp_vol(ymu) : ymu818_set_spk_vol(ymu);
+}
+
+static void ymu818_path_off(struct ymu818_priv *ymu)
+{
+	ymu818_run(ymu, ymu->hp ? YMU818_SEC_AMP_OFF_HP : YMU818_SEC_AMP_OFF_SPK);
+	ymu818_run(ymu, ymu->hp ? YMU818_SEC_STOP_HP : YMU818_SEC_STOP_SPK);
+}
+
+static int ymu818_start(struct ymu818_priv *ymu)
+{
+	int ret;
+
+	ret = ymu818_power_on(ymu);
+	if (ret)
+		return ret;
+
+	ymu->hp = ymu818_hp_plugged(ymu);
+	ret = ymu818_path_on(ymu);
+	if (ret)
+		return ret;
+	ymu->running = true;
+	return 0;
+}
+
+static void ymu818_stop(struct ymu818_priv *ymu)
+{
+	ymu818_path_off(ymu);
+	ymu->running = false;
+}
+
+/* Report the jack and, during playback, move the output to the other path */
+static void ymu818_hp_work(struct work_struct *work)
+{
+	struct ymu818_priv *ymu = container_of(work, struct ymu818_priv,
+					       hp_work.work);
+	bool hp;
+
+	/* The pin has settled: listen again, then read it */
+	if (xchg(&ymu->hp_irq_off, false))
+		enable_irq(ymu->hp_irq);
+	hp = ymu818_hp_plugged(ymu);
+
+	if (ymu->jack.jack)
+		snd_soc_jack_report(&ymu->jack, hp ? SND_JACK_HEADPHONE : 0,
+				    SND_JACK_HEADPHONE);
+
+	mutex_lock(&ymu->lock);
+	if (ymu->running && hp != ymu->hp) {
+		ymu818_path_off(ymu);
+		ymu->hp = hp;
+		if (ymu818_path_on(ymu)) {
+			/* Stay silent; the next playback resets and inits again */
+			ymu->running = false;
+			ymu->inited = false;
+		}
+	}
+	mutex_unlock(&ymu->lock);
+}
+
+/*
+ * The detect contact chatters for a while when a plug goes in (about 1800
+ * edges once). Stay deaf until the debounce work runs.
+ */
+static irqreturn_t ymu818_hp_irq(int irq, void *data)
+{
+	struct ymu818_priv *ymu = data;
+
+	disable_irq_nosync(irq);
+	WRITE_ONCE(ymu->hp_irq_off, true);
+	mod_delayed_work(system_power_efficient_wq, &ymu->hp_work,
+			 msecs_to_jiffies(YMU818_HP_DEBOUNCE_MS));
+	return IRQ_HANDLED;
+}
+
+static int ymu818_prepare(struct snd_pcm_substream *substream,
+			  struct snd_soc_dai *dai)
+{
+	struct ymu818_priv *ymu = snd_soc_component_get_drvdata(dai->component);
+	int ret = 0;
+
+	mutex_lock(&ymu->lock);
+	if (!ymu->running) {
+		ret = ymu818_start(ymu);
+		/* The chip may be half started: reset and init again next time */
+		if (ret)
+			ymu->inited = false;
+	}
+	mutex_unlock(&ymu->lock);
+	return ret;
+}
+
+static void ymu818_shutdown(struct snd_pcm_substream *substream,
+			    struct snd_soc_dai *dai)
+{
+	struct ymu818_priv *ymu = snd_soc_component_get_drvdata(dai->component);
+
+	mutex_lock(&ymu->lock);
+	if (ymu->running)
+		ymu818_stop(ymu);
+	mutex_unlock(&ymu->lock);
+}
+
+static int ymu818_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	/* SAIF0 is the clock provider; the WinCE driver only uses I2S */
+	if ((fmt & SND_SOC_DAIFMT_FORMAT_MASK) != SND_SOC_DAIFMT_I2S ||
+	    (fmt & SND_SOC_DAIFMT_INV_MASK) != SND_SOC_DAIFMT_NB_NF ||
+	    (fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) != SND_SOC_DAIFMT_CBC_CFC)
+		return -EINVAL;
+	return 0;
+}
+
+static const struct snd_soc_dai_ops ymu818_dai_ops = {
+	.prepare	= ymu818_prepare,
+	.shutdown	= ymu818_shutdown,
+	.set_fmt	= ymu818_set_fmt,
+};
+
+static struct snd_soc_dai_driver ymu818_dai = {
+	.name = "ymu818-hifi",
+	.playback = {
+		.stream_name	= "Playback",
+		.channels_min	= 2,
+		.channels_max	= 2,
+		/* the coefficients in the firmware are made for 44.1kHz */
+		.rates		= SNDRV_PCM_RATE_44100,
+		.formats	= SNDRV_PCM_FMTBIT_S16_LE,
+	},
+	.ops = &ymu818_dai_ops,
+};
+
+/* private_value: true for the headphone volume, false for the speaker */
+static int ymu818_vol_info(struct snd_kcontrol *kcontrol,
+			   struct snd_ctl_elem_info *uinfo)
+{
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	uinfo->count = 1;
+	uinfo->value.integer.min = 0;
+	uinfo->value.integer.max = kcontrol->private_value ?
+				   YMU818_HP_VOL_MAX : YMU818_SPK_VOL_MAX;
+	return 0;
+}
+
+static int ymu818_vol_get(struct snd_kcontrol *kcontrol,
+			  struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *c = snd_soc_kcontrol_component(kcontrol);
+	struct ymu818_priv *ymu = snd_soc_component_get_drvdata(c);
+
+	ucontrol->value.integer.value[0] = kcontrol->private_value ?
+					   ymu->hp_vol : ymu->spk_vol;
+	return 0;
+}
+
+static int ymu818_vol_put(struct snd_kcontrol *kcontrol,
+			  struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *c = snd_soc_kcontrol_component(kcontrol);
+	struct ymu818_priv *ymu = snd_soc_component_get_drvdata(c);
+	bool hp = kcontrol->private_value;
+	unsigned int *vol = hp ? &ymu->hp_vol : &ymu->spk_vol;
+	long v = ucontrol->value.integer.value[0];
+	int ret = 0;
+
+	if (v < 0 || v > (hp ? YMU818_HP_VOL_MAX : YMU818_SPK_VOL_MAX))
+		return -EINVAL;
+	mutex_lock(&ymu->lock);
+	if (v == *vol) {
+		mutex_unlock(&ymu->lock);
+		return 0;
+	}
+	*vol = v;
+	if (ymu->running && ymu->hp == hp)
+		ret = hp ? ymu818_set_hp_vol(ymu) : ymu818_set_spk_vol(ymu);
+	mutex_unlock(&ymu->lock);
+	return ret ? ret : 1;
+}
+
+static const struct snd_kcontrol_new ymu818_controls[] = {
+	{
+		.iface	= SNDRV_CTL_ELEM_IFACE_MIXER,
+		.name	= "Speaker Playback Volume",
+		.info	= ymu818_vol_info,
+		.get	= ymu818_vol_get,
+		.put	= ymu818_vol_put,
+		.private_value = false,
+	},
+	{
+		.iface	= SNDRV_CTL_ELEM_IFACE_MIXER,
+		.name	= "Headphone Playback Volume",
+		.info	= ymu818_vol_info,
+		.get	= ymu818_vol_get,
+		.put	= ymu818_vol_put,
+		.private_value = true,
+	},
+};
+
+/* The card exists now: add the jack and report where it is */
+static int ymu818_component_probe(struct snd_soc_component *component)
+{
+	struct ymu818_priv *ymu = snd_soc_component_get_drvdata(component);
+	int ret;
+
+	if (!ymu->hp_det)
+		return 0;
+	ret = snd_soc_card_jack_new(component->card, "Headphone",
+				    SND_JACK_HEADPHONE, &ymu->jack);
+	if (ret)
+		return ret;
+	mod_delayed_work(system_power_efficient_wq, &ymu->hp_work, 0);
+	return 0;
+}
+
+static void ymu818_component_remove(struct snd_soc_component *component)
+{
+	struct ymu818_priv *ymu = snd_soc_component_get_drvdata(component);
+
+	cancel_delayed_work_sync(&ymu->hp_work);
+	ymu->jack.jack = NULL;
+}
+
+static const struct snd_soc_component_driver ymu818_component = {
+	.probe			= ymu818_component_probe,
+	.remove			= ymu818_component_remove,
+	.controls		= ymu818_controls,
+	.num_controls		= ARRAY_SIZE(ymu818_controls),
+	.endianness		= 1,
+};
+
+static int ymu818_i2c_probe(struct i2c_client *i2c)
+{
+	struct device *dev = &i2c->dev;
+	struct ymu818_priv *ymu;
+	u8 id;
+	int ret;
+
+	ymu = devm_kzalloc(dev, sizeof(*ymu), GFP_KERNEL);
+	if (!ymu)
+		return -ENOMEM;
+	ymu->i2c = i2c;
+	ymu->spk_vol = YMU818_SPK_VOL_DEFAULT;
+	ymu->hp_vol = YMU818_HP_VOL_DEFAULT;
+	mutex_init(&ymu->lock);
+	INIT_DELAYED_WORK(&ymu->hp_work, ymu818_hp_work);
+	i2c_set_clientdata(i2c, ymu);
+
+	/* Keep the chip out of reset; it is pulsed before the init sequence */
+	ymu->reset = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ymu->reset))
+		return dev_err_probe(dev, PTR_ERR(ymu->reset), "reset gpio\n");
+	ymu->hp_det = devm_gpiod_get_optional(dev, "hp-det", GPIOD_IN);
+	if (IS_ERR(ymu->hp_det))
+		return dev_err_probe(dev, PTR_ERR(ymu->hp_det), "hp-det gpio\n");
+
+	if (ymu->hp_det) {
+		int irq = gpiod_to_irq(ymu->hp_det);
+
+		if (irq < 0)
+			return dev_err_probe(dev, irq, "hp-det irq\n");
+		ymu->hp_irq = irq;
+		ret = devm_request_irq(dev, irq, ymu818_hp_irq,
+				       IRQF_TRIGGER_RISING | IRQF_TRIGGER_FALLING,
+				       "ymu818-hp-det", ymu);
+		if (ret)
+			return dev_err_probe(dev, ret, "hp-det irq\n");
+	}
+
+	ymu->fw_name = YMU818_FW_DEFAULT;
+	of_property_read_string(dev->of_node, "firmware-name", &ymu->fw_name);
+
+	ret = ymu818_read(ymu, 0x000, &id);
+	if (ret)
+		return dev_err_probe(dev, ret, "no response at %#x\n", i2c->addr);
+	dev_info(dev, "YMU818 found, reg 0x000 = %02x\n", id);
+
+	return devm_snd_soc_register_component(dev, &ymu818_component, &ymu818_dai, 1);
+}
+
+static void ymu818_i2c_remove(struct i2c_client *i2c)
+{
+	struct ymu818_priv *ymu = i2c_get_clientdata(i2c);
+
+	/*
+	 * The irq is devm and goes after this. Keep it disabled across the
+	 * cancel: a running hp_work may enable it once, but not past our disable.
+	 */
+	if (ymu->hp_irq > 0)
+		disable_irq(ymu->hp_irq);
+	cancel_delayed_work_sync(&ymu->hp_work);
+	release_firmware(ymu->fw);
+}
+
+static const struct of_device_id ymu818_of_match[] = {
+	{ .compatible = "yamaha,ymu818" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ymu818_of_match);
+
+static const struct i2c_device_id ymu818_i2c_id[] = {
+	{ "ymu818", 0 },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, ymu818_i2c_id);
+
+static struct i2c_driver ymu818_i2c_driver = {
+	.driver = {
+		.name = "ymu818",
+		.of_match_table = ymu818_of_match,
+	},
+	.probe_new	= ymu818_i2c_probe,
+	.remove		= ymu818_i2c_remove,
+	.id_table	= ymu818_i2c_id,
+};
+module_i2c_driver(ymu818_i2c_driver);
+
+MODULE_DESCRIPTION("Yamaha YMU818 codec driver");
+MODULE_LICENSE("GPL");
+MODULE_FIRMWARE(YMU818_FW_DEFAULT);
