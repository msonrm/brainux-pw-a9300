diff --git a/arch/arm/boot/dts/imx28-pwa7200.dts b/arch/arm/boot/dts/imx28-pwa7200.dts
index 48bb8a1a6..3a0cccadf 100644
--- a/arch/arm/boot/dts/imx28-pwa7200.dts
+++ b/arch/arm/boot/dts/imx28-pwa7200.dts
@@ -159,3 +159,45 @@ &buzzer_cold {
 &buzzer {
 	status = "okay";
 };
+
+/*
+ * Audio: Yamaha YMU818 on I2C0 (0x3a), PCM from SAIF0 (I2S, 44.1kHz, MCLK 512fs).
+ * Found by disassembling the WinCE ymu818_wavdev.dll of PW-A9300 and running
+ * it in an emulator. Other models in this family may carry a different
+ * amplifier; only PW-A9300 has been checked.
+ */
+&pinctrl {
+	ymu818_pins: ymu818@0 {
+		reg = <0>;
+		fsl,pinmux-ids = <
+			MX28_PAD_SPDIF__GPIO_3_27	/* reset, active low */
+			MX28_PAD_SSP2_SS1__GPIO_2_20	/* headphone detect, low when plugged */
+		>;
+	};
+};
+
+&sgtl5000 {
+	status = "disabled";
+};
+
+&i2c0 {
+	ymu818: codec@3a {
+		compatible = "yamaha,ymu818";
+		reg = <0x3a>;
+		#sound-dai-cells = <0>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&ymu818_pins>;
+		reset-gpios = <&gpio3 27 GPIO_ACTIVE_LOW>;
+		hp-det-gpios = <&gpio2 20 GPIO_ACTIVE_LOW>;
+		firmware-name = "ymu818-brain.bin";
+	};
+};
+
+/ {
+	sound {
+		compatible = "fsl,mxs-audio-ymu818";
+		model = "brain-ymu818";
+		saif-controllers = <&saif0>;
+		audio-codec = <&ymu818>;
+	};
+};
